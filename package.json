{
  "name": "vigil",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "tsc --noEmit",
    "copy-wasm": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});const wasmSrc=fs.existsSync('node_modules/sql.js/dist/sql-wasm.wasm')?'node_modules/sql.js/dist/sql-wasm.wasm':null;const browserSrc=fs.existsSync('node_modules/sql.js/dist/sql-wasm-browser.wasm')?'node_modules/sql.js/dist/sql-wasm-browser.wasm':wasmSrc;if(wasmSrc){fs.copyFileSync(wasmSrc,'public/sql-wasm.wasm');if(browserSrc)fs.copyFileSync(browserSrc,'public/sql-wasm-browser.wasm');}\"",
    "postinstall": "npm run copy-wasm"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.20",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-sharing": "~57.0.18",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.5.1",
    "sql.js": "^1.14.2",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "private": true
}
